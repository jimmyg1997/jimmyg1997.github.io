{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Locally",
      "type": "shell",
      "command": "${workspaceFolder}/restart-jekyll.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
